# Copy to .env.test (git-ignored) to run integration tests.
# Integration tests DELETE all users between cases, so this must be a
# local or throwaway database — never the production Supabase database.
#
# Example local database:
#   docker run -d --name vbc-test-db -e POSTGRES_USER=vbc -e POSTGRES_PASSWORD=vbc_test_only \
#     -e POSTGRES_DB=vbc_test -p 127.0.0.1:54329:5432 postgres:16-alpine
DATABASE_URL=postgresql://vbc:vbc_test_only@127.0.0.1:54329/vbc_test
PAYLOAD_SECRET=local-test-secret-not-for-production
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Must be exactly "true" or the test setup refuses to run
ALLOW_TEST_DB_RESET=true
