# Local development only. Copy to .env.development.local (git-ignored).
# `next dev` and the Payload CLI refuse any database other than local vbc_dev.
DATABASE_URL=postgresql://LOCAL_USER:LOCAL_PASSWORD@127.0.0.1:54329/vbc_dev

# Used to encrypt JWT tokens
PAYLOAD_SECRET=YOUR_LOCAL_SECRET_HERE

# Used to configure CORS, format links and more. No trailing slash
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Production (Supabase) is configured only in the deployment environment, together with
# ALLOW_REMOTE_DATABASE=true. Never set that flag in .env, .env.*.local, .env.test or any committed file.
